# Discord bot token — Discord Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# YouTube Data API v3 key — Google Cloud Console > APIs & Services > Credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Optional: a guild (server) ID for instant slash-command sync during development.
# Without this, commands sync globally, which can take up to an hour to appear.
# DISCORD_GUILD_ID=your_test_server_id_here
