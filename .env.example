# Discord bot token — Discord Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# --- Lavalink node -----------------------------------------------------------
# This bot plays audio through a Lavalink v4 node instead of connecting to voice
# directly. See the README for how to run one locally or host one.

# Must match `lavalink.server.password` in the node's application.yml. Required.
LAVALINK_PASSWORD=youshallnotpass

# Where the node is. Defaults to 127.0.0.1:2333 (a Lavalink running locally).
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333

# Set to true for a node behind HTTPS/WSS — usually together with PORT=443.
# A Discloud-hosted node needs: HOST=<subdomain>.discloud.app, PORT=443, SECURE=true
LAVALINK_SECURE=false

# Optional: give the node's full base URI instead of host/port/secure.
# Takes precedence over all three when set. e.g. https://lava.example.com:443
# LAVALINK_URI=

# --- Optional ----------------------------------------------------------------
# YouTube Data API v3 key — Google Cloud Console > APIs & Services > Credentials.
# Used for /play search. Without it, the Lavalink node's own YouTube search is
# used instead, so this is optional.
# YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Optional: a guild (server) ID for instant slash-command sync during development.
# Without this, commands sync globally, which can take up to an hour to appear.
# DISCORD_GUILD_ID=your_test_server_id_here
